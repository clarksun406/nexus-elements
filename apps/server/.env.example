# Copy to apps/server/.env or export these in the shell.
# Sample keys match the examples app. Do not use them when NODE_ENV=production.

NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info

# memory (no database) or postgres
STORE=postgres
DATABASE_URL=postgres://nexus:nexus@127.0.0.1:5432/nexus

NEXUS_PUBLISHABLE_KEY=pk_test_nexus_example_key
NEXUS_SECRET_KEY=sk_test_nexus_example_secret
NEXUS_ACCOUNT_ID=acct_test_default
NEXUS_WEBHOOK_SECRET=whsec_test_nexus_example
# NEXUS_WEBHOOK_URL=http://127.0.0.1:4000/webhooks/nexus

# Browser origins allowed to call the API. Same-origin requests omit Origin and are allowed.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Examples create PaymentIntents from the browser with pk_. Set false to require sk_.
ALLOW_PUBLISHABLE_CREATES=true

RATE_LIMIT_MAX=600
TOKEN_RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Optional. When unset, a sandbox RSA key is generated and (on postgres) stored in encryption_keys.
# Production should inject a KMS/HSM PEM and not rely on the database copy.
# NEXUS_RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
NEXUS_ENCRYPTION_KEY_ID=ek_test_rsa_oaep

# Prefix for hosted checkout URLs. Leave empty to emit same-origin paths (/__nexus-checkout/...).
PUBLIC_BASE_URL=
NEXUS_FRAME_ANCESTORS="'self' http://localhost:* http://127.0.0.1:*"
