{
  "name": "@nexus-elements/server",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Nexus Elements merchant backend — SDK contract over Postgres",
  "scripts": {
    "dev": "node --watch dist/index.js",
    "build": "tsc -p tsconfig.json && mkdir -p dist/db/migrations && cp src/db/migrations/001_init.sql dist/db/migrations/",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "COVERAGE=1 vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@nexus-elements/contracts": "workspace:*",
    "fastify": "^5.6.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.5",
    "@vitest/coverage-v8": "3.2.7",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
