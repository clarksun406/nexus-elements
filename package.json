{
  "name": "nexus-elements",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @nexus-elements/mock-api build && pnpm --filter @nexus-elements/fields build && pnpm --filter examples dev",
    "build": "pnpm -r build",
    "build:examples": "pnpm --filter examples build",
    "test": "pnpm -r --if-present test",
    "test:coverage": "pnpm -r --filter @nexus-elements/core --filter @nexus-elements/fields --filter @nexus-elements/server test:coverage",
    "e2e": "node ./node_modules/@playwright/test/cli.js test",
    "e2e:server": "node ./node_modules/@playwright/test/cli.js test -c playwright.server.config.ts",
    "typecheck": "pnpm --filter @nexus-elements/contracts build && pnpm --filter @nexus-elements/core exec tsc --emitDeclarationOnly --outDir dist && pnpm -r typecheck",
    "lint": "eslint . --ext .ts,.vue",
    "verify:bundle": "pnpm build && node scripts/verify-bundle.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-onboarding": "^10.5.5",
    "@storybook/addon-vitest": "^10.5.5",
    "@storybook/vue3-vite": "^10.5.5",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vitest/browser": "3.2.7",
    "@vitest/coverage-v8": "3.2.7",
    "playwright": "^1.62.0",
    "storybook": "^10.5.5",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
