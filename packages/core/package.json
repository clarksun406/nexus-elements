{
  "name": "@nexus-elements/core",
  "version": "0.1.0",
  "type": "module",
  "description": "Nexus Elements SDK core — framework-agnostic payment elements",
  "main": "./dist/nexus-core.cjs",
  "module": "./dist/nexus-core.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nexus-core.js",
      "require": "./dist/nexus-core.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && tsc --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "3.2.7",
    "jsdom": "^30.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
